{
  "resources": {
    "postgres": {
      "type": "container.v0",
      "connectionString": "Host={postgres.bindings.tcp.host};Port={postgres.bindings.tcp.port};Username=postgres;Password={postgres-password.value}",
      "image": "docker.io/library/postgres:18.3",
      "volumes": [
        {
          "name": "mediaplatform.apphost-20736787d9-postgres-data",
          "target": "/var/lib/postgresql",
          "readOnly": false
        }
      ],
      "env": {
        "POSTGRES_HOST_AUTH_METHOD": "scram-sha-256",
        "POSTGRES_INITDB_ARGS": "--auth-host=scram-sha-256 --auth-local=scram-sha-256",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "{postgres-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 5432
        }
      }
    },
    "identitydb": {
      "type": "value.v0",
      "connectionString": "{postgres.connectionString};Database=identitydb"
    },
    "mediadb": {
      "type": "value.v0",
      "connectionString": "{postgres.connectionString};Database=mediadb"
    },
    "blogdb": {
      "type": "value.v0",
      "connectionString": "{postgres.connectionString};Database=blogdb"
    },
    "chatdb": {
      "type": "value.v0",
      "connectionString": "{postgres.connectionString};Database=chatdb"
    },
    "redis": {
      "type": "container.v0",
      "connectionString": "{redis.bindings.tcp.host}:{redis.bindings.tcp.port},password={redis-password.value}{cond-redis-bindings-tcp-tlsenabled-d148d83a.connectionString}",
      "image": "docker.io/library/redis:8.6",
      "entrypoint": "/bin/sh",
      "args": [
        "-c",
        "redis-server --requirepass $REDIS_PASSWORD"
      ],
      "env": {
        "REDIS_PASSWORD": "{redis-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "redis",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 6379
        }
      }
    },
    "minio": {
      "type": "container.v0",
      "image": "cgr.dev/chainguard/minio:latest",
      "args": [
        "server",
        "/data",
        "--console-address",
        ":9001"
      ],
      "volumes": [
        {
          "name": "miniodata",
          "target": "/data",
          "readOnly": false
        }
      ],
      "env": {
        "MINIO_ROOT_USER": "miniouser",
        "MINIO_ROOT_PASSWORD": "miniopassword"
      },
      "bindings": {
        "s3": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 9000
        },
        "console": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 9001
        }
      }
    },
    "identity-api": {
      "type": "project.v0",
      "path": "../MediaPlatform.Identity.Api/MediaPlatform.Identity.Api.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{identity-api.bindings.http.targetPort}",
        "JwtSettings__Secret": "super_secret_key_which_must_be_very_long_and_secure_12345!",
        "JwtSettings__Issuer": "MediaPlatformApi",
        "JwtSettings__Audience": "MediaPlatformClient",
        "ConnectionStrings__identitydb": "{identitydb.connectionString}",
        "IDENTITYDB_HOST": "{postgres.bindings.tcp.host}",
        "IDENTITYDB_PORT": "{postgres.bindings.tcp.port}",
        "IDENTITYDB_USERNAME": "postgres",
        "IDENTITYDB_PASSWORD": "{postgres-password.value}",
        "IDENTITYDB_URI": "postgresql://postgres:{postgres-password-uri-encoded.value}@{postgres.bindings.tcp.host}:{postgres.bindings.tcp.port}/identitydb",
        "IDENTITYDB_JDBCCONNECTIONSTRING": "jdbc:postgresql://{postgres.bindings.tcp.host}:{postgres.bindings.tcp.port}/identitydb",
        "IDENTITYDB_DATABASENAME": "identitydb"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "media-api": {
      "type": "project.v0",
      "path": "../MediaPlatform.Media.Api/MediaPlatform.Media.Api.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{media-api.bindings.http.targetPort}",
        "JwtSettings__Secret": "super_secret_key_which_must_be_very_long_and_secure_12345!",
        "JwtSettings__Issuer": "MediaPlatformApi",
        "JwtSettings__Audience": "MediaPlatformClient",
        "ConnectionStrings__mediadb": "{mediadb.connectionString}",
        "MEDIADB_HOST": "{postgres.bindings.tcp.host}",
        "MEDIADB_PORT": "{postgres.bindings.tcp.port}",
        "MEDIADB_USERNAME": "postgres",
        "MEDIADB_PASSWORD": "{postgres-password.value}",
        "MEDIADB_URI": "postgresql://postgres:{postgres-password-uri-encoded.value}@{postgres.bindings.tcp.host}:{postgres.bindings.tcp.port}/mediadb",
        "MEDIADB_JDBCCONNECTIONSTRING": "jdbc:postgresql://{postgres.bindings.tcp.host}:{postgres.bindings.tcp.port}/mediadb",
        "MEDIADB_DATABASENAME": "mediadb"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "content-api": {
      "type": "project.v0",
      "path": "../MediaPlatform.Content.Api/MediaPlatform.Content.Api.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{content-api.bindings.http.targetPort}",
        "JwtSettings__Secret": "super_secret_key_which_must_be_very_long_and_secure_12345!",
        "JwtSettings__Issuer": "MediaPlatformApi",
        "JwtSettings__Audience": "MediaPlatformClient",
        "ConnectionStrings__blogdb": "{blogdb.connectionString}",
        "BLOGDB_HOST": "{postgres.bindings.tcp.host}",
        "BLOGDB_PORT": "{postgres.bindings.tcp.port}",
        "BLOGDB_USERNAME": "postgres",
        "BLOGDB_PASSWORD": "{postgres-password.value}",
        "BLOGDB_URI": "postgresql://postgres:{postgres-password-uri-encoded.value}@{postgres.bindings.tcp.host}:{postgres.bindings.tcp.port}/blogdb",
        "BLOGDB_JDBCCONNECTIONSTRING": "jdbc:postgresql://{postgres.bindings.tcp.host}:{postgres.bindings.tcp.port}/blogdb",
        "BLOGDB_DATABASENAME": "blogdb",
        "ConnectionStrings__redis": "{redis.connectionString}",
        "REDIS_HOST": "{redis.bindings.tcp.host}",
        "REDIS_PORT": "{redis.bindings.tcp.port}",
        "REDIS_PASSWORD": "{redis-password.value}",
        "REDIS_URI": "{redis.bindings.tcp.scheme}://:{redis-password-uri-encoded.value}@{redis.bindings.tcp.host}:{redis.bindings.tcp.port}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "chat-api": {
      "type": "project.v0",
      "path": "../MediaPlatform.Chat.Api/MediaPlatform.Chat.Api.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{chat-api.bindings.http.targetPort}",
        "JwtSettings__Secret": "super_secret_key_which_must_be_very_long_and_secure_12345!",
        "JwtSettings__Issuer": "MediaPlatformApi",
        "JwtSettings__Audience": "MediaPlatformClient",
        "ConnectionStrings__chatdb": "{chatdb.connectionString}",
        "CHATDB_HOST": "{postgres.bindings.tcp.host}",
        "CHATDB_PORT": "{postgres.bindings.tcp.port}",
        "CHATDB_USERNAME": "postgres",
        "CHATDB_PASSWORD": "{postgres-password.value}",
        "CHATDB_URI": "postgresql://postgres:{postgres-password-uri-encoded.value}@{postgres.bindings.tcp.host}:{postgres.bindings.tcp.port}/chatdb",
        "CHATDB_JDBCCONNECTIONSTRING": "jdbc:postgresql://{postgres.bindings.tcp.host}:{postgres.bindings.tcp.port}/chatdb",
        "CHATDB_DATABASENAME": "chatdb",
        "IDENTITY_API_HTTP": "{identity-api.bindings.http.url}",
        "services__identity-api__http__0": "{identity-api.bindings.http.url}",
        "IDENTITY_API_HTTPS": "{identity-api.bindings.https.url}",
        "services__identity-api__https__0": "{identity-api.bindings.https.url}",
        "ConnectionStrings__redis": "{redis.connectionString}",
        "REDIS_HOST": "{redis.bindings.tcp.host}",
        "REDIS_PORT": "{redis.bindings.tcp.port}",
        "REDIS_PASSWORD": "{redis-password.value}",
        "REDIS_URI": "{redis.bindings.tcp.scheme}://:{redis-password-uri-encoded.value}@{redis.bindings.tcp.host}:{redis.bindings.tcp.port}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "gateway": {
      "type": "project.v0",
      "path": "../MediaPlatform.Gateway/MediaPlatform.Gateway.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{gateway.bindings.http.targetPort};{gateway.bindings.public.targetPort}",
        "IDENTITY_API_HTTP": "{identity-api.bindings.http.url}",
        "services__identity-api__http__0": "{identity-api.bindings.http.url}",
        "IDENTITY_API_HTTPS": "{identity-api.bindings.https.url}",
        "services__identity-api__https__0": "{identity-api.bindings.https.url}",
        "MEDIA_API_HTTP": "{media-api.bindings.http.url}",
        "services__media-api__http__0": "{media-api.bindings.http.url}",
        "MEDIA_API_HTTPS": "{media-api.bindings.https.url}",
        "services__media-api__https__0": "{media-api.bindings.https.url}",
        "CONTENT_API_HTTP": "{content-api.bindings.http.url}",
        "services__content-api__http__0": "{content-api.bindings.http.url}",
        "CONTENT_API_HTTPS": "{content-api.bindings.https.url}",
        "services__content-api__https__0": "{content-api.bindings.https.url}",
        "CHAT_API_HTTP": "{chat-api.bindings.http.url}",
        "services__chat-api__http__0": "{chat-api.bindings.http.url}",
        "CHAT_API_HTTPS": "{chat-api.bindings.https.url}",
        "services__chat-api__https__0": "{chat-api.bindings.https.url}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        },
        "public": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "port": 5000,
          "targetPort": 8000
        }
      }
    },
    "postgres-password": {
      "type": "parameter.v0",
      "value": "{postgres-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true,
          "default": {
            "generate": {
              "minLength": 22
            }
          }
        }
      }
    },
    "postgres-password-uri-encoded": {
      "type": "annotated.string",
      "value": "{postgres-password.value}",
      "filter": "uri"
    },
    "redis-password": {
      "type": "parameter.v0",
      "value": "{redis-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true,
          "default": {
            "generate": {
              "minLength": 22,
              "special": false
            }
          }
        }
      }
    },
    "redis-password-uri-encoded": {
      "type": "annotated.string",
      "value": "{redis-password.value}",
      "filter": "uri"
    },
    "cond-redis-bindings-tcp-tlsenabled-d148d83a": {
      "type": "value.v0",
      "connectionString": ""
    }
  }
}