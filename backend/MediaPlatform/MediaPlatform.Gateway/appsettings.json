{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "media-route": {
        "ClusterId": "media-cluster",
        "Match": { "Path": "/api/media/{**catch-all}" }
      },
      "videos-route": {
        "ClusterId": "media-cluster",
        "Match": { "Path": "/api/videos/{**catch-all}" }
      },
      "posts-route": {
        "ClusterId": "content-cluster",
        "Match": { "Path": "/api/posts/{**catch-all}" }
      },
      "comments-route": {
        "ClusterId": "content-cluster",
        "Match": { "Path": "/api/comments/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": { "d1": { "Address": "http://identity-api" } }
      },
      "media-cluster": {
        "Destinations": { "d1": { "Address": "http://media-api" } }
      },
      "content-cluster": {
        "Destinations": { "d1": { "Address": "http://content-api" } }
      }
    }
  }
}